APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=enterprise_doc
POSTGRES_PASSWORD=enterprise_doc_local
POSTGRES_DB=enterprise_doc
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=enterprise_doc_local
MINIO_ROOT_PASSWORD=enterprise_doc_local_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=enterprise_doc_local

DATABASE__URL=postgresql+psycopg://enterprise_doc:enterprise_doc_local@127.0.0.1:5432/enterprise_doc
DATABASE__CONNECT_TIMEOUT_SECONDS=3

REDIS__URL=redis://127.0.0.1:6379/0
REDIS__CONNECT_TIMEOUT_SECONDS=3

OBJECT_STORE__ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE__PRESIGN_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE__ACCESS_KEY=enterprise_doc_local
OBJECT_STORE__SECRET_KEY=enterprise_doc_local_secret
OBJECT_STORE__REGION=us-east-1
OBJECT_STORE__DOCUMENTS_BUCKET=documents
OBJECT_STORE__ARTIFACTS_BUCKET=artifacts
OBJECT_STORE__SECURE=false
OBJECT_STORE__CONNECT_TIMEOUT_SECONDS=3
OBJECT_STORE__READ_TIMEOUT_SECONDS=30
OBJECT_STORE__MAX_POOL_CONNECTIONS=32
OBJECT_STORE__PRESIGN_TTL_SECONDS=900
OBJECT_STORE__MULTIPART_CHECKSUM_MODE=native_sha256

OTEL__ENABLED=false
OTEL__EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL__SAMPLE_RATIO=1.0
OTEL__METRICS_ENABLED=true

API__HOST=127.0.0.1
API__PORT=8000
API__CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

AUTH__ISSUER=enterprise-doc-agent-local
AUTH__AUDIENCE=enterprise-doc-agent-api
AUTH__SIGNING_KEY=enterprise_doc_local_jwt_signing_key_change_me_32_bytes
AUTH__TOKEN_TTL_SECONDS=28800
AUTH__MAX_TOKEN_LENGTH=4096

UPLOAD__MAX_FILE_SIZE_BYTES=10737418240
UPLOAD__MAX_FILENAME_LENGTH=255
UPLOAD__PREFERRED_PART_SIZE_BYTES=16777216
UPLOAD__SESSION_TTL_SECONDS=86400
UPLOAD__ENVELOPE_SAMPLE_BYTES=65536
UPLOAD__MAX_DOCX_CENTRAL_DIRECTORY_BYTES=4194304
UPLOAD__MAX_DOCX_ENTRIES=10000
UPLOAD__MAX_DOCX_DECLARED_UNCOMPRESSED_BYTES=2147483648
UPLOAD__MAX_DOCX_MEMBER_UNCOMPRESSED_BYTES=536870912
UPLOAD__MAX_DOCX_MEMBER_COMPRESSION_RATIO=100.0
UPLOAD__CLEANUP_BATCH_SIZE=100
UPLOAD__CLEANUP_EXPIRY_GRACE_SECONDS=60
UPLOAD__CLEANUP_COMPLETING_GRACE_SECONDS=900
UPLOAD__CLEANUP_ORPHAN_GRACE_SECONDS=3600
UPLOAD__CLEANUP_CLAIM_TTL_SECONDS=300

WORKER__HOST=127.0.0.1
WORKER__PROBE_PORT=8081
WORKER__CONSUMER_METRICS_PORT=8082

FAULT_INJECTION__ENABLED=false
FAULT_INJECTION__TARGET=none
FAULT_INJECTION__MODE=none
FAULT_INJECTION__TRIGGER_AFTER=0
FAULT_INJECTION__TRIGGER_EVERY=0
FAULT_INJECTION__DELAY_MS=0

MODEL__ROUTE_ID=default
# MODEL__ROUTE_DEADLINE_SECONDS=60
MODEL__CIRCUIT_FAILURE_THRESHOLD=3
MODEL__CIRCUIT_COOLDOWN_SECONDS=30

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_OBJECT_STORE_ORIGINS=http://127.0.0.1:9000
