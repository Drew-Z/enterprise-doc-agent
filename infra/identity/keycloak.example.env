# Local example only. Replace the port/realm with the actual running instance.
# The validation runner uses random ports and ephemeral credentials, then stops it.
BROWSER_AUTH__ENABLED=false
BROWSER_AUTH__WEB_ORIGIN=http://localhost:5173
BROWSER_AUTH__ISSUER=http://127.0.0.1:18080/realms/docagent
BROWSER_AUTH__AUTHORIZATION_ENDPOINT=http://127.0.0.1:18080/realms/docagent/protocol/openid-connect/auth
BROWSER_AUTH__TOKEN_ENDPOINT=http://127.0.0.1:18080/realms/docagent/protocol/openid-connect/token
BROWSER_AUTH__JWKS_URL=http://127.0.0.1:18080/realms/docagent/protocol/openid-connect/certs
BROWSER_AUTH__CLIENT_ID=docagent-web
# Supply BROWSER_AUTH__CLIENT_SECRET through the server's private secret channel.
BROWSER_AUTH__ALGORITHMS=["RS256"]
# Outside local/test, all origins/endpoints require HTTPS and a confidential secret.
